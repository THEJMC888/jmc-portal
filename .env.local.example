# Supabase (get these from your Supabase project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Bunny.net (optional — used for video embedding)
NEXT_PUBLIC_BUNNY_LIBRARY_ID=your-bunny-library-id

# OpenAI — used for journal audio transcription (Whisper API)
OPENAI_API_KEY=sk-...
