# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API (Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here

# Service role key — NEVER prefix with NEXT_PUBLIC_ — server-only
# Project Settings → API → service_role (keep this out of git and out of the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Fireflies ────────────────────────────────────────────────────────────────
# Fireflies dashboard → Integrations → API
FIREFLIES_API_KEY=your-fireflies-api-key-here
# Fireflies dashboard → Integrations → Webhooks → Secret
FIREFLIES_WEBHOOK_SECRET=your-webhook-secret-here

# ─── Vercel Blob ──────────────────────────────────────────────────────────────
# Vercel dashboard → Storage → Blob → your store → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Admin ────────────────────────────────────────────────────────────────────
# Server-only admin email — used in API routes and RLS policies (never NEXT_PUBLIC_).
ADMIN_EMAIL=rng@thejourneymencollective.com
# Client-side admin email — controls which UI elements are shown to the admin.
NEXT_PUBLIC_ADMIN_EMAIL=rng@thejourneymencollective.com

# ─── OpenAI (journal transcription) ──────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Bunny.net (optional — video CDN) ────────────────────────────────────────
NEXT_PUBLIC_BUNNY_LIBRARY_ID=your-bunny-library-id
